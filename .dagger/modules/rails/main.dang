pub description = "Rails tests run by a module of this repository"

"""
Runs `bin/rails test` from this repository's own module, so the generated
clients the tests load resolve their local paths against this repository.
"""
type Rails {
  """
  Run `bin/rails test` in the workspace root and fail with its output.
  """
  test(ws: Workspace!): Void @check {
    # Not `ruby.run`: its exec would run in the `ruby` module, where client paths do not resolve.
    let ran = ruby.container(ws).withExec(["bin/rails", "test"], expect: ANY)
    if (ran.exitCode != 0) {
      raise "Rails tests failed:\n" + ran.stdout + ran.stderr
    }
    null
  }
}
