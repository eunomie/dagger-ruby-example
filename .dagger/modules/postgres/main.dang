pub description = "A disposable Postgres server for tests"

type Postgres {
  """
  Postgres 17 from the official image, listening on 5432 with user and password `postgres`.
  """
  pub service: Service! {
    container
      .from("postgres:17-alpine")
      .withEnvVariable("POSTGRES_PASSWORD", "postgres")
      .withExposedPort(5432)
      .asService
  }
}
